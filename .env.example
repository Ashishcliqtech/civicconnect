# Copy to .env and fill in. NEVER commit the real .env file.
FLASK_APP=run.py
FLASK_ENV=development            # development | production
SECRET_KEY=change-me-to-a-long-random-string
# Optional: folder for the SQLite DB and uploads (use the Render disk mount in production)
# DATA_DIR=/var/data
# Optional: managed database instead of SQLite
# DATABASE_URL=postgresql://user:password@host:5432/dbname
MAX_UPLOAD_MB=5
# Optional email (core app works without it)
MAIL_ENABLED=false
